// Production database schema for AI Office Toolbox.
// Use a persistent Postgres database in production, such as Vercel Postgres,
// Supabase, or Neon. SQLite is not suitable for Vercel production persistence.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String               @id @default(cuid())
  email        String               @unique
  passwordHash String               @map("password_hash")
  isVerified   Boolean              @default(false) @map("is_verified")
  verificationCodeHash String?      @map("verification_code_hash")
  verificationExpiresAt DateTime?   @map("verification_expires_at")
  role         String               @default("user")
  currentPlan  String?              @map("current_plan")
  remainingQuota Int                @default(0) @map("remaining_quota")
  planExpiry   DateTime?            @map("plan_expiry")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  quota        UserQuota?
  usageRecords UsageRecord[]
  orders       Order[]
  resetTokens  PasswordResetToken[]
  subscriptions Subscription[]

  @@index([role])
  @@index([isVerified])
  @@index([verificationExpiresAt])
  @@map("users")
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model UserQuota {
  id             String   @id @default(cuid())
  userId         String   @unique @map("user_id")
  totalQuota     Int      @default(0) @map("total_quota")
  usedQuota      Int      @default(0) @map("used_quota")
  remainingQuota Int      @default(0) @map("remaining_quota")
  updatedAt      DateTime @updatedAt @map("updated_at")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_quotas")
}

model UsageRecord {
  id           String   @id @default(cuid())
  userId       String   @map("user_id")
  toolId       String   @map("tool_id")
  toolName     String   @map("tool_name")
  inputType    String   @map("input_type")
  status       String
  quotaUsed    Int      @map("quota_used")
  errorMessage String?  @map("error_message")
  createdAt    DateTime @default(now()) @map("created_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([toolId])
  @@map("usage_records")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  event     String
  level     String   @default("info")
  ip        String?
  userAgent String?
  message   String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@map("audit_logs")
}

model RateLimitEvent {
  id        String   @id @default(cuid())
  key       String
  action    String
  createdAt DateTime @default(now())

  @@index([key, action, createdAt])
  @@map("rate_limit_events")
}

model ContactSubmission {
  id            String   @id @default(cuid())
  name          String
  company       String?
  phone         String?
  wechat        String?
  email         String?
  douyin        String?
  industry      String
  budget        String
  description   String
  sourcePage    String   @default("联系定制") @map("source_page")
  feishuTableId String?  @map("feishu_table_id")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([createdAt])
  @@index([email])
  @@map("contact_submissions")
}

model Subscription {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  plan      String
  status    String    @default("active")
  credits   Int       @default(0)
  expiresAt DateTime? @map("expires_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
  @@index([expiresAt])
  @@map("subscriptions")
}

model Order {
  id              String    @id @default(cuid())
  userId          String    @map("user_id")
  userEmail       String    @map("user_email")
  planName        String    @map("plan_name")
  planPrice       Float     @map("plan_price")
  planCount       Int       @map("plan_count")
  status          String    @default("pending")
  amount          Decimal
  quotaAmount     Int       @map("quota_amount")
  paymentProvider String    @map("payment_provider")
  paymentStatus   String    @default("pending") @map("payment_status")
  paymentMethod   String?   @map("payment_method")
  paymentTime     DateTime? @map("payment_time")
  paymentScreenshot String? @map("payment_screenshot")
  paymentTradeNo  String?   @map("payment_trade_no")
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")
  paidAt          DateTime? @map("paid_at")
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
  @@index([userId, status])
  @@index([status, createdAt])
  @@index([paymentStatus])
  @@index([paymentTradeNo])
  @@map("orders")
}
